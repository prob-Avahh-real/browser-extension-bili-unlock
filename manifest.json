{
  "manifest_version": 3,
  "name": "biliUnlock",
  "version": "1.0.0",
  "description": "为 B 站播放器提供倍速、清晰度、连播和进度控制。",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://bilibili.com/*",
        "*://*.b23.tv/*",
        "*://b23.tv/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "biliUnlock",
    "default_popup": "popup.html"
  }
}
